TELEGRAM_BOT_TOKEN=your_bot_token_here

# Образы из GHCR. Для конкретного коммита: sha-<полный SHA> и test-sha-<полный SHA>.
TGDLBOT_IMAGE_TAG=latest
TGDLBOT_TEST_IMAGE_TAG=test

# Необязательно: cookies Instagram (Netscape). Для Docker:
# Используйте отдельный аккаунт без доступа к закрытым профилям: сессия общая для пользователей бота.
# INSTAGRAM_COOKIES_FILE=/app/cookies/instagram.txt
# Для локального запуска: cookies/instagram.txt
INSTAGRAM_COOKIES_FILE=
